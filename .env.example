APP_NAME=NORI
DATABASE_URL=sqlite:///./nori.db
BOT_TOKEN=
API_BASE_URL=http://127.0.0.1:8000
# Comma-separated owner Telegram numeric IDs. Only owners can manage admin roles.
OWNER_TELEGRAM_IDS=
# Deprecated SERVICE_TOKEN and ADMIN_TELEGRAM_IDS are ignored by v0.6 API.
PAIRING_TTL_SECONDS=300
DEVICE_PAIRING_ENABLED=false
DEVICE_LIMIT=2
AUTO_CREATE_SCHEMA=false

# Game-dependent types stay disabled until separately approved and tested.
V2_APPROVED_EVENT_TYPES=
V2_APPROVED_COMMAND_TYPES=
