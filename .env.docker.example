# Local testing only. Generate a random hex password and use it in both lines.
POSTGRES_DB=nori
POSTGRES_USER=nori
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
DATABASE_URL=postgresql+psycopg://nori:REPLACE_WITH_RANDOM_HEX@postgres:5432/nori
# Use only a separate test bot. Never commit real tokens.
BOT_TOKEN=
OWNER_TELEGRAM_IDS=
DEVICE_PAIRING_ENABLED=false
AUTO_CREATE_SCHEMA=false

# Game-dependent types stay disabled until separately approved and tested.
V2_APPROVED_EVENT_TYPES=
V2_APPROVED_COMMAND_TYPES=
